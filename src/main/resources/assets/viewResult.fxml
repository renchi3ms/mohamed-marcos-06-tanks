<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" minHeight="500.0" minWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlResult">
   <children>
      <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="txtTitle" alignment="CENTER" prefHeight="48.0" prefWidth="600.0" text="Resultat">
               <font>
                  <Font size="32.0" />
               </font>
            </Label>
            <Label fx:id="txtWinner" alignment="CENTER" prefHeight="32.0" prefWidth="600.0">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label fx:id="txtLoser" alignment="CENTER" prefHeight="32.0" prefWidth="600.0">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Button onAction="#onBackClick" text="Back to lobby">
               <VBox.margin>
                  <Insets top="24.0" />
               </VBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
