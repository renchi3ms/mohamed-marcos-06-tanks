<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchor" minHeight="500.0" minWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlConfig">
   <children>
      <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Connexió al servidor" />
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <ComboBox fx:id="txtProtocol" prefWidth="90.0" />
                  <TextField fx:id="txtHost" prefWidth="240.0" />
                  <TextField fx:id="txtPort" prefWidth="80.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Escenari" />
                  <ComboBox fx:id="cmbScenario" prefWidth="140.0" />
               </children>
            </HBox>
            <Button fx:id="btnConnect" onAction="#onConnectClick" text="Connect" />
            <Label fx:id="txtMessage" alignment="CENTER" prefHeight="20.0" prefWidth="400.0" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
